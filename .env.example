# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it.

# Directus's own JWT signing secrets. Generate two random strings, e.g.:
#   openssl rand -hex 32
DIRECTUS_KEY=
DIRECTUS_SECRET=

# First-boot admin account for the Directus dashboard (http://localhost:8055).
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# Supabase Dashboard -> Project Settings -> Database -> Connection string
# (use the "Session pooler" URI, port 5432, so Directus holds a stable
# connection). Looks like:
#   postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_CONNECTION_STRING=

# Supabase Dashboard -> Project Settings -> Storage -> S3 Connection.
# Create these credentials there, and create a PUBLIC bucket (e.g.
# "cms-assets") beforehand in Storage -> Buckets.
SUPABASE_PROJECT_ID=yvvuitjsunankrffcpck
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=cms-assets
SUPABASE_STORAGE_REGION=
